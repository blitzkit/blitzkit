---
import { assertSecret } from "@blitzkit/core";
import locales from "@blitzkit/i18n/locales.json";
import { mixStaticPaths } from "../../../astro/mixStaticPaths";
import HomeHero from "../../../components/HomeHero.astro";
import HomeTanks from "../../../components/HomeTanks.astro";
import { tools, type Tool } from "../../../config/tools";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getStaticPaths as _getStaticPaths } from "../_index";

const MAX_TOOLS_PER_ROW = 2;

const environment = assertSecret(import.meta.env.PUBLIC_ENVIRONMENT);
const { locale } = Astro.props;
const rows: Tool[][] = [];

for (const id in tools) {
  const tool = tools[id];

  if ("disabled" in tool && tool.disabled) continue;

  const compatibleRow = rows.find(
    (row) =>
      row.length < MAX_TOOLS_PER_ROW &&
      !("significant" in row[0] && row[0].significant),
  );

  if (compatibleRow) {
    compatibleRow.push(tool);
  } else {
    rows.push([tool]);
  }
}

export const getStaticPaths = mixStaticPaths(_getStaticPaths, () => {
  return locales.supported.map(({ locale }) => ({
    props: { locale },
    params: { locale: locale === locales.default ? undefined : locale },
  }));
});
---

<BaseLayout tool={tools.home} accent="blue" {locale}>
  <HomeHero {locale} />

  <!-- <HelpTranslate {locale} /> -->

  <!-- {environment === "preview" && <AesonPlug />} -->

  <HomeTanks {locale} />
  <!-- <HomePlayers {locale} /> -->
  <!-- <HomeGames {locale} /> -->
  <!-- <HomeCosmetics {locale} /> -->
  <!-- <HomeTechnical {locale} /> -->
</BaseLayout>

