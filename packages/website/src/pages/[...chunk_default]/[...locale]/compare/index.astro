---
import ColorScale from "../../../../components/ColorScale.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { Page } from "./_index";

export { getStaticPaths } from "../index.astro";

const { locale } = Astro.props;
---

<BaseLayout accent="pink" {locale}>
  <ColorScale color="red" />
  <ColorScale color="red" alpha />
  <ColorScale color="jade" />
  <ColorScale color="amber" />
  <ColorScale color="amber" alpha />
  <ColorScale color="blue" />

  <Page {locale} client:load />
</BaseLayout>
