---
import { mixStaticPaths } from "../../../../../astro/mixStaticPaths";
import { embedConfigurations } from "../../../../../config/embeds";
import { tools } from "../../../../../config/tools";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { getStaticPaths as _getStaticPaths } from "../index.astro";
import { Page } from "./_index";

export const getStaticPaths = mixStaticPaths(_getStaticPaths, async () => {
  return (
    Object.keys(embedConfigurations) as (keyof typeof embedConfigurations)[]
  ).map((embed) => ({
    params: { embed },
    props: { embed },
  }));
});

const { locale, embed } = Astro.props;
---

<BaseLayout tool={tools.embed} {locale} accent="red">
  <Page {locale} client:load {embed} />
</BaseLayout>
