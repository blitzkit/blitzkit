---
import { api } from "../../../../../api/dynamic";
import { mixStaticPaths } from "../../../../../astro/mixStaticPaths";
import ColorRanks from "../../../../../components/ColorRanks.astro";
import ColorScale from "../../../../../components/ColorScale.astro";
import { TankopediaCharacteristics } from "../../../../../components/TankopediaCharacteristics";
import TankopediaGameModeAbilities from "../../../../../components/TankopediaGameModeAbilities.astro";
import { TankopediaLoadout } from "../../../../../components/TankopediaLoadout";
import { TankopediaSandbox } from "../../../../../components/TankopediaSandbox";
import { TankopediaTabs } from "../../../../../components/TankopediaTabs";
import TankopediaTitle from "../../../../../components/TankopediaTitle.astro";
import TankopediaVideos from "../../../../../components/TankopediaVideos.astro";
import { tools } from "../../../../../config/tools";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { getStaticPaths as _getStaticPaths } from "../index.astro";

export const getStaticPaths = mixStaticPaths(_getStaticPaths, async () => {
  const tanks = await api.tanks();

  return Object.values(tanks.tanks).map((tank) => ({
    params: { slug: tank.slug },
    props: { id: tank.id },
  }));
});

const { id, locale } = Astro.props;
---

<ColorScale color="ruby" />
<ColorScale color="cyan" />
<ColorScale color="green" />
<ColorRanks />

<style>
  .page {
    flex-grow: 1;
    display: flex;

    gap: var(--space-4);

    .sandbox {
      flex-grow: 1;

      display: flex;
      flex-direction: column;
      gap: var(--space-4);

      @media (pointer: fine) {
        padding-top: var(--space-4);
      }
    }
  }
</style>

<BaseLayout tool={tools.tanks} {locale} accent="violet">
  <div class="page">
    <div class="sandbox">
      <TankopediaTitle {id} {locale} />
      <TankopediaSandbox {id} {locale} client:load />
      <TankopediaCharacteristics {id} {locale} client:load />
      <TankopediaGameModeAbilities {id} {locale} />
      <TankopediaVideos {id} {locale} />
      <TankopediaTabs {id} {locale} client:load />
    </div>

    <TankopediaLoadout {id} {locale} client:load />
  </div>
</BaseLayout>
