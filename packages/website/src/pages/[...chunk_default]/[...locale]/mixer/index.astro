---
import ToolOpenGraph from "../../../../components/ToolOpenGraph.astro";
import { tools } from "../../../../config/tools";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { Page } from "./_index";

export { getStaticPaths } from "../index.astro";

const { locale } = Astro.props;
---

<ToolOpenGraph {locale} tool={tools.mixer} />

<BaseLayout tool={tools.mixer} accent="gray" {locale} solidNavbar>
  <Page {locale} client:only="react">
    <Page {locale} skeleton slot="fallback" />
  </Page>
</BaseLayout>
