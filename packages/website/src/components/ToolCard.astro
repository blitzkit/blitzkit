---
import type { Tool } from "../constants/tools";
import { getStrings } from "../core/i18n/getStrings";
import { Heading } from "./Heading";
import { LinkI18n } from "./LinkI18n";
import { Text } from "./Text";

interface Props {
  tool: Tool;
  locale: string;
}

const { locale, tool } = Astro.props;
const strings = getStrings(locale);
const toolStrings =
  strings.website.tools[
    (tool.strings ?? tool.id) as keyof typeof strings.website.tools
  ];
---

<style>
  .container {
    display: flex;

    border-radius: var(--radius-3);
    background-size: cover;
    background-position: center;
    height: 16rem;

    position: relative;
    overflow: hidden;

    &[data-disabled="true"] {
      opacity: 0.25;
    }
  }

  .link {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    color: inherit;

    .background {
      flex: 1;

      background-size: cover;
      background-position: center;
    }

    .content {
      display: flex;
      align-items: center;
      justify-content: space-between;

      width: 100%;

      gap: var(--space-4);

      .wrapper {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    }
  }
</style>

<div
  style={{ backgroundImage: `url(/assets/images/tools/${tool.id}.webp)` }}
  class="container"
>
  <LinkI18n
    {locale}
    className="link"
    underline="none"
    href={tool.href ?? `/${tool.id}`}
    target={tool.href ? "_blank" : undefined}
  >
    <div
      class="background"
      style={{ backgroundImage: `url(/assets/images/tools/${tool.id}.webp)` }}
    >
    </div>

    <div
      class="content"
      style={{
        backgroundColor: "var(--color-panel-translucent)",
        backdropFilter: "blur(64px) brightness(50%)",
        WebkitBackdropFilter: "blur(64px)",
      }}
    >
      <div class="wrapper">
        <Heading weight="medium">
          {toolStrings.name}
        </Heading>

        <Text color="gray">
          {toolStrings.description}
        </Text>
      </div>
    </div>
  </LinkI18n>
</div>
