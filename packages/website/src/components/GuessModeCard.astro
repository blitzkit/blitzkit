---
import { CaretRightIcon } from "@radix-ui/react-icons";
import {
  Box,
  Button,
  Flex,
  Heading,
  Text,
  type ButtonProps,
} from "@radix-ui/themes";
import type { GuessMode } from "../constants/guessModes";
import { getStrings } from "../core/i18n/getStrings";
import { LinkI18n } from "./LinkI18n";

interface Props {
  mode: GuessMode;
  locale: string;
}

const { locale, mode } = Astro.props;
const strings = getStrings(locale);
const modeStrings =
  strings.website.tools.guess.modes[
    mode.id as keyof typeof strings.website.tools.guess.modes
  ];
const background = mode.image
  ? `url(/assets/images/tools/${mode.image}.webp)`
  : `linear-gradient(135deg, var(--${mode.button}-a5), var(--${mode.button}-a2))`;
---

<style>
  .container {
    border-radius: var(--radius-2);
    background-size: cover;
    background-position: center;
    height: 16rem;
  }

  .link {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    color: inherit;
  }
</style>

<Flex
  style={{ backgroundImage: background }}
  className="container"
  position="relative"
  overflow="hidden"
  flexGrow="1"
  flexBasis={{ initial: undefined, sm: "0" }}
>
  <LinkI18n
    {locale}
    className="link"
    underline="none"
    href={`/guess/${mode.id}`}
  >
    <Box
      flexGrow="1"
      style={{
        backgroundImage: background,
        backgroundSize: "cover",
        backgroundPosition: "center",
      }}
    />

    <Flex
      px="6"
      py="4"
      gap="4"
      align="center"
      justify="between"
      width="100%"
      direction={{ initial: "column", xs: "row" }}
      style={{
        backgroundColor: "var(--color-panel-translucent)",
        backdropFilter: "blur(64px)",
        WebkitBackdropFilter: "blur(64px)",
      }}
    >
      <Flex
        direction="column"
        justify="center"
        align={{ initial: "center", xs: "start" }}
      >
        <Heading
          align={{ initial: "center", sm: "left" }}
          size={{ initial: "6", sm: "5" }}
          weight="medium"
        >
          {modeStrings.name}
        </Heading>
        <Text align={{ initial: "center", sm: "left" }} size="3" color="gray">
          {modeStrings.description}
        </Text>
      </Flex>

      <Button
        color={mode.button as ButtonProps["color"]}
        style={{ cursor: "inherit" }}
      >
        {modeStrings.button}
        <CaretRightIcon />
      </Button>
    </Flex>
  </LinkI18n>
</Flex>
