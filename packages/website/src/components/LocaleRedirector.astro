<script>
  import locales from "@blitzkit/i18n/locales.json";
  import { getBestLocale } from "../core/i18n/getBestLocale";

  const pathname = window.location.pathname;
  const hasPreference = localStorage.getItem("preferred-locale") !== null;
  const bestLocale = getBestLocale();
  const currentLocale =
    locales.supported.find(
      ({ locale }) =>
        locale !== locales.default &&
        (pathname === `/${locale}` || pathname.startsWith(`/${locale}/`)),
    )?.locale ?? locales.default;

  if (
    bestLocale !== currentLocale &&
    (hasPreference || currentLocale === locales.default)
  ) {
    const rawPath =
      currentLocale === locales.default
        ? pathname
        : pathname.slice(`/${currentLocale}`.length) || "/";

    window.location.pathname = `${
      bestLocale === locales.default ? "" : `/${bestLocale}`
    }${rawPath}`;
  }
</script>
