---
import { api } from "../api/dynamic";
import { tools } from "../constants/tools";
import { Heading } from "./Heading";
import HomeSection from "./HomeSection.astro";
import ToolCard from "./ToolCard.astro";
import ToolCardLayoutColumn from "./ToolCardLayoutColumn.astro";
import ToolCardLayoutRoot from "./ToolCardLayoutRoot.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const strings = await api.strings(locale);
---

<HomeSection>
  <Heading size="2">{strings.home.cosmetics}</Heading>

  <ToolCardLayoutRoot minor>
    <ToolCardLayoutColumn>
      <ToolCard {locale} tool={tools.avatars} />
    </ToolCardLayoutColumn>

    <ToolCardLayoutColumn>
      <ToolCard {locale} tool={tools.backgrounds} />
    </ToolCardLayoutColumn>
  </ToolCardLayoutRoot>
</HomeSection>
