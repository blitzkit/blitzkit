---
import { Heading } from "@radix-ui/themes";
import { tools } from "../constants/tools";
import { getStrings } from "../core/i18n/getStrings";
import ToolCard from "./ToolCard.astro";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const strings = getStrings(locale);
---

<Heading size="8">{strings.home.players}</Heading>

<ToolCard {locale} tool={tools.players} />
<ToolCard {locale} tool={tools.session} />
<ToolCard {locale} tool={tools.playlist} />
