---
import { alias } from "@blitzkit/core";
import { MagnifyingGlassIcon } from "@radix-ui/react-icons";
import { api } from "../api/dynamic";
import { resolveBranchName } from "../core/blitzkit/branches";
import { Heading } from "./Heading";
import { TextField } from "./TextField";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const strings = await api.strings(locale);
const branchName = resolveBranchName(strings);
const isBranchNamed = branchName !== undefined;

// TODO: detect season
const season = "winter";
---

<style>
  .wrapper {
    background-size: cover;

    .hero {
      padding: var(--space-7) 0;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-4);

      background: linear-gradient(var(--black-a8), var(--black-a4));

      .search {
        max-width: 20rem;
        width: 100%;
      }
    }
  }
</style>

<section
  class="wrapper"
  style={{
    backgroundImage: `url(${alias("api", `/hero/${season}.webp`)})`,
  }}
>
  <div class="hero">
    <Heading weight="black">{strings.common.name}</Heading>

    <TextField className="search" placeholder="Search tanks...">
      <MagnifyingGlassIcon />
    </TextField>
  </div>
</section>
