---
import BaseMeta from "../components/BaseMeta.astro";
import BaseStyles from "../components/BaseStyles.astro";
import ColorAlias from "../components/ColorAlias.astro";
import ColorScale from "../components/ColorScale.astro";
import NavbarDesktop from "../components/NavbarDesktop.astro";
import NavbarMobile from "../components/NavbarMobile.astro";
import SystemTheme from "../components/SystemTheme.astro";
import { tools } from "../constants/tools";
import type { LocaleAcceptorProps } from "../hooks/useLocale";
import type { Color } from "../ui/color";

type Props = LocaleAcceptorProps & {
  accent: Color;
};

const { locale, accent } = Astro.props;

const tool = tools.tanks;
---

<html lang={locale} class="dark">
  <head>
    <BaseMeta />
    <SystemTheme />

    <ColorScale color="mauve" />
    <ColorScale color="mauve" alpha />
    <ColorAlias color="mauve" alias="gray" />
    <ColorAlias color="mauve" alpha alias="gray" />

    <ColorScale color="black" alpha />
    <ColorScale color="white" alpha />

    <ColorScale color={accent} />
    <ColorScale color={accent} alpha />
    <ColorAlias color={accent} alias="accent" />
    <ColorAlias color={accent} alpha alias="accent" />

    <BaseStyles />

    <style>
      :root {
        interpolate-size: allow-keywords;

        background-color: var(--gray-1);
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }

      body {
        margin: 0;

        display: flex;

        background-color: var(--gray-1);
        color: var(--gray-12);
        font-family: var(--font-family-regular);

        .main {
          flex: 1;
        }

        @media screen and (max-width: 80rem) {
          flex-direction: column-reverse;
        }
      }
    </style>
  </head>

  <body>
    <NavbarDesktop {locale} {tool} />
    <NavbarMobile {locale} {tool} />

    <main class="main">
      <slot />
    </main>
  </body>
</html>
