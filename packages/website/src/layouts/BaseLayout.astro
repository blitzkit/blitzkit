---
import AutoFocus from "../components/AutoFocus.astro";
import BaseMeta from "../components/BaseMeta.astro";
import BaseStyles from "../components/BaseStyles.astro";
import ColorAlias from "../components/ColorAlias.astro";
import ColorScale from "../components/ColorScale.astro";
import NavbarCourse from "../components/NavbarCourse.astro";
import NavbarFine from "../components/NavbarFine.astro";
import SystemTheme from "../components/SystemTheme.astro";
import type { Tool } from "../constants/tools";
import type { LocaleAcceptorProps } from "../hooks/useLocale";
import type { Color } from "../ui/color";

type Props = LocaleAcceptorProps & {
  accent: Color;
  solidNavbar?: boolean;
  tool: Tool;
};

const { locale, accent, solidNavbar = false, tool } = Astro.props;
---

<html lang={locale} class="dark">
  <head>
    <BaseMeta />
    <SystemTheme />

    <ColorScale color="mauve" />
    <ColorAlias color="mauve" alias="gray" />

    <ColorScale color="black" />
    <ColorScale color="white" />

    <ColorScale color={accent} />
    <ColorAlias color={accent} alias="accent" />

    <BaseStyles />

    <style>
      :root {
        interpolate-size: allow-keywords;

        background-color: var(--gray-1);
      }

      :global(*) {
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }

      body {
        margin: 0;
        min-height: 100dvh;

        display: flex;
        flex-direction: column;

        @media (pointer: fine) {
          flex-direction: row-reverse;
        }

        background-color: var(--gray-1);
        color: var(--gray-12);
        font-family: var(--font-family-regular);

        .main {
          flex: 1;
          min-width: 0;

          display: flex;
          flex-direction: column;

          gap: var(--page-padding);
        }
      }
    </style>
  </head>

  <body data-solid-navbar={solidNavbar}>
    <main class="main">
      <slot />
    </main>

    <AutoFocus />

    <NavbarFine {locale} {tool} />
    <NavbarCourse {locale} {tool} solid={solidNavbar} />
  </body>
</html>
